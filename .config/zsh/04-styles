#------------------------------------------------------
# ------------------ Dynamic Theme --------------------
#------------------------------------------------------
if [[ -f "$HOME/.config/zsh/current-theme.zsh" ]]; then
  source "$HOME/.config/zsh/current-theme.zsh"
else
  export FZF_DEFAULT_OPTS=" \
  --color=bg+:#3b4252,bg:#2e3440,spinner:#88c0d0,hl:#bf616a \
  --color=fg:#d8dee9,header:#bf616a,info:#81a1c1,pointer:#88c0d0 \
  --color=marker:#88c0d0,fg+:#eceff4,prompt:#81a1c1,hl+:#bf616a \
  --color=selected-bg:#434c5e \
  --color=border:#4c566a"
  export BAT_THEME="Nord"
fi

# Function to reload styles and reset prompt in existing terminals
_reload_theme_in_shell() {
  if [[ -f "$HOME/.config/zsh/current-theme.zsh" ]]; then
    source "$HOME/.config/zsh/current-theme.zsh"
  fi
  if [[ -o interactive ]] && zle 2>/dev/null; then
    zle reset-prompt 2>/dev/null
  fi
}

# Trap SIGUSR1 for instant reload when theme-switcher runs
TRAPUSR1() {
  _reload_theme_in_shell
}

# Precmd hook to automatically refresh if theme changed
_last_theme_state=""
_theme_precmd_check() {
  if [[ -f "$HOME/.config/theme-active/current.txt" ]]; then
    local cur
    cur=$(<"$HOME/.config/theme-active/current.txt")
    if [[ "$cur" != "$_last_theme_state" ]]; then
      _last_theme_state="$cur"
      _reload_theme_in_shell
    fi
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _theme_precmd_check
